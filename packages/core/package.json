{
  "name": "@resiliojs/core",
  "version": "0.1.1",
  "description": "Framework-independent typed error presentation policy engine",
  "license": "MIT",
  "keywords": [
    "error-handling",
    "presentation-policy",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noonnofus/resilio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/noonnofus/resilio#readme",
  "bugs": {
    "url": "https://github.com/noonnofus/resilio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
