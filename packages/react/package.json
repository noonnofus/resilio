{
  "name": "@resilio/react",
  "version": "0.1.0",
  "description": "Headless React bindings for typed error presentation policies",
  "license": "MIT",
  "keywords": [
    "react",
    "error-boundary",
    "error-handling",
    "presentation-policy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noonnofus/resilio.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/noonnofus/resilio#readme",
  "bugs": {
    "url": "https://github.com/noonnofus/resilio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@resilio/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
