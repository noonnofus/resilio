{
  "name": "@resiliojs/next",
  "version": "0.1.1",
  "description": "Next.js facade for typed public errors and presentation policies",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "react",
    "server-actions",
    "error-handling",
    "presentation-policy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noonnofus/resilio.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/noonnofus/resilio#readme",
  "bugs": {
    "url": "https://github.com/noonnofus/resilio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@resiliojs/core": "workspace:^",
    "@resiliojs/react": "workspace:^"
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@testing-library/react": "^16.1.0"
  }
}
